# Simple WebDAW Container - No React Compilation Issues
FROM nginx:alpine

# Copy the working HTML WebDAW directly
COPY src/components/WebDAW_standalone.html /usr/share/nginx/html/index.html
COPY src/components/webdaw/ /usr/share/nginx/html/webdaw/
COPY public/ /usr/share/nginx/html/

# Copy nginx configuration
COPY nginx.simple.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
